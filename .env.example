# ============================================================
#  Insurance Fraud Doc Intelligence — Environment Variables
#  Copy this file to .env and fill in your values.
#  NEVER commit .env to GitHub.
# ============================================================

# --- LLM Provider (choose ONE) ----------------------------

# Option A: OpenAI
OPENAI_API_KEY=sk-...

# Option B: Google Gemini
GOOGLE_API_KEY=AIza...

# Which provider to use: "openai" or "gemini"
LLM_PROVIDER=gemini

# --- Neo4j Connection -------------------------------------

# AuraDB (cloud) example:
#   NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
# Desktop (local) example:
#   NEO4J_URI=bolt://localhost:7687

NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your-password-here

# --- Optional Settings ------------------------------------

# Log level: DEBUG, INFO, WARNING
LOG_LEVEL=INFO

# Docs folder path (relative to project root)
DOCS_PATH=data/sample_docs
